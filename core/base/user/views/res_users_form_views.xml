<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- ir.ui.view : res.users (form) -->
        <view id="view_res_users_form" model="res.users" type="form">
            <header>
                <button name="action_archive" string="Archive" type="object" class=""/>
                <button name="action_reset_password" string="Send reset instructions" type="object" class="oe_highlight"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                </div>
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="e.g. Mitchell Admin"/>
                    </h1>
                    <div class="flex space-x-4">
                        <field name="email" string="Email" widget="email"/>
                        <field name="phone" string="Work phone"/>
                        <field name="mobile" string="Mobile"/>
                    </div>
                </div>

                <group>
                    <group string="Access">
                        <field name="login" string="Login"/>
                        <field name="active" string="Active"/>
                    </group>
                    <group string="Company">
                        <field name="company_id" string="Company"/>
                    </group>
                </group>

                <notebook>
                    <page string="Preferences">
                        <group>
                            <group string="Localization">
                                <field name="lang" string="Language"/>
                                <field name="tz" string="Timezone"/>
                            </group>
                            <group string="Signature">
                                <field name="signature" string="Email signature"/>
                            </group>
                        </group>
                    </page>
                    <page string="Account Security">
                        <group>
                            <label for="login" string="Login is used to sign in. Keep it unique."/>
                            <field name="login" string="Login"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter>
                <field name="signature" string="Log" widget="mail_thread"/>
            </chatter>
        </view>
    </data>
</sumeru>

<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- Window Action -->
        <record id="action_{{.Name}}" model="sys.action.window">
            <field name="name">{{.HumanTitle}}</field>
            <field name="res_model">{{.ModelDotted}}</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first {{.HumanTitle}}!
                </p>
            </field>
        </record>
    </data>
</sumeru>

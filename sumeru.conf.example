# Copy to sumeru.conf (keep next to go.mod). Paths are relative to this file unless absolute.
# Also read by `go generate ./cmd/sumeru` for addons_path.

[options]

# Database (required)
db_host = localhost
db_port = 5432
db_user = postgres
db_password = postgres
db_name = sumeru
db_sslmode = disable

# HTTP (required)
http_port = 8080
dev_mode = true

# Setup wizard — first run only; leave setup_token empty to skip
setup_localhost_only = true
setup_token =

# Addons (required) — comma-separated directories
addons_path = addons

# Logging — enable stdout and/or log_file (at least one sink)
log_enabled = true
log_stdout = true
log_timezone = Local
log_rolling = false

# File logging (optional; uncomment for local log files)
# log_file = ./logs/sumeru.log
# log_rolling = true
# log_max_size_mb = 100
# log_max_backups = 10
# log_max_age_days = 30

# Branding / paths (optional — defaults work when this INI lives in the sumeru repo)
# sumeru_home =
# assets_path =
# templates_path =
# brand_css =
# logo_path =
# company_display_name =
# user_display_name =

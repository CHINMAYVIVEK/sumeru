<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_mail.message_tree" model="mail.message" type="tree">
            <field name="create_date" string="When"/>
            <field name="author" string="Author"/>
            <field name="subtype" string="Subtype"/>
            <field name="model" string="Model"/>
            <field name="core_id" string="Record"/>
            <field name="body" string="Body"/>
        </view>
        <view id="view_mail.message_form" model="mail.message" type="form">
            <sheet>
                <group>
                    <field name="create_date" string="When"/>
                    <field name="author" string="Author"/>
                    <field name="subtype" string="Subtype"/>
                    <field name="model" string="Model"/>
                    <field name="core_id" string="Record"/>
                    <field name="company_id" string="Company"/>
                    <field name="body" string="Body"/>
                </group>
            </sheet>
        </view>

        <view id="view_mail.activity_tree" model="mail.activity" type="tree">
            <field name="name" string="Activity"/>
            <field name="date_deadline" string="Due"/>
            <field name="user_id" string="Assigned"/>
            <field name="state" string="State"/>
            <field name="model" string="Model"/>
        </view>
        <view id="view_mail.activity_form" model="mail.activity" type="form">
            <sheet>
                <group>
                    <field name="name" string="Activity"/>
                    <field name="summary" string="Summary"/>
                    <field name="model" string="Model"/>
                    <field name="res_id" string="Record"/>
                    <field name="user_id" string="Assigned To"/>
                    <field name="date_deadline" string="Due Date"/>
                    <field name="state" string="State"/>
                </group>
            </sheet>
        </view>

        <record id="action_mail.message" model="sys.action.window">
            <field name="name">action_mail.message</field>
            <field name="core_model">mail.message</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_mail.activity" model="sys.action.window">
            <field name="name">action_mail.activity</field>
            <field name="core_model">mail.activity</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</sumeru>

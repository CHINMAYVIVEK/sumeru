<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_sys.cron_list" model="sys.cron" type="list">
            <field name="name" string="Name"/>
            <field name="interval_number" string="Interval (min)"/>
            <field name="event_name" string="Event"/>
            <field name="next_call" string="Next"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_sys.cron_form" model="sys.cron" type="form">
            <sheet>
                <group>
                    <field name="name" string="Name"/>
                    <field name="code" string="Code"/>
                    <field name="event_name" string="Event Name"/>
                    <field name="interval_number" string="Interval (minutes)"/>
                    <field name="active" string="Active"/>
                    <field name="next_call" string="Next Call"/>
                    <field name="last_call" string="Last Call"/>
                </group>
            </sheet>
        </view>

        <view id="view_sys.workflow.transition_list" model="sys.workflow.transition" type="list">
            <field name="name" string="Name"/>
            <field name="model" string="Model"/>
            <field name="from_state" string="From"/>
            <field name="to_state" string="To"/>
            <field name="group_id" string="Group"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_sys.workflow.transition_form" model="sys.workflow.transition" type="form">
            <sheet>
                <group>
                    <field name="name" string="Name"/>
                    <field name="model" string="Model"/>
                    <field name="from_state" string="From"/>
                    <field name="to_state" string="To"/>
                    <field name="group_id" string="Required Group"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>

        <view id="view_sys.server.action_list" model="sys.server.action" type="list">
            <field name="name" string="Name"/>
            <field name="model" string="Model"/>
            <field name="event_name" string="Event"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_sys.server.action_form" model="sys.server.action" type="form">
            <sheet>
                <group>
                    <field name="name" string="Name"/>
                    <field name="model" string="Model"/>
                    <field name="event_name" string="On Event"/>
                    <field name="code" string="Code / Notes"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>

        <record id="action_sys.cron" model="sys.action.window">
            <field name="name">action_sys.cron</field>
            <field name="core_model">sys.cron</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_sys.workflow.transition" model="sys.action.window">
            <field name="name">action_sys.workflow.transition</field>
            <field name="core_model">sys.workflow.transition</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_sys.server.action" model="sys.action.window">
            <field name="name">action_sys.server.action</field>
            <field name="core_model">sys.server.action</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</sumeru>

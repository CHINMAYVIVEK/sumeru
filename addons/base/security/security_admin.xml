<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- ============================================================
             core.group — tree + form
        ============================================================ -->
        <view id="view_core.group_tree" model="core.group" type="tree">
            <field name="name" string="Name"/>
            <field name="category_id" string="Application"/>
            <field name="sequence" string="Sequence"/>
        </view>

        <view id="view_core.group_form" model="core.group" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="e.g. Sales / User"/>
                    </h1>
                </div>
                <group>
                    <group string="Identification">
                        <field name="category_id" string="Application"/>
                        <field name="sequence" string="Display Order"/>
                    </group>
                    <group string="Hierarchy">
                        <separator string="Implication"/>
                        <label string="Higher levels include lower ones (Manager implies User). Assign levels on the user Access Rights tab."/>
                    </group>
                </group>
            </sheet>
        </view>

        <!-- ============================================================
             sys.access — tree + form
        ============================================================ -->
        <view id="view_sys.access_tree" model="sys.access" type="tree">
            <field name="name" string="Name"/>
            <field name="model" string="Model"/>
            <field name="perm_read" string="Read"/>
            <field name="perm_write" string="Write"/>
            <field name="perm_create" string="Create"/>
            <field name="perm_unlink" string="Delete"/>
        </view>

        <view id="view_sys.access_form" model="sys.access" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="e.g. access_sale_order_manager"/>
                    </h1>
                </div>
                <group>
                    <group string="Scope">
                        <field name="model" string="Model (technical name)"/>
                        <field name="group_id" string="Group (leave empty for global)"/>
                    </group>
                    <group string="Permissions">
                        <field name="perm_read" string="Read"/>
                        <field name="perm_write" string="Write"/>
                        <field name="perm_create" string="Create"/>
                        <field name="perm_unlink" string="Delete"/>
                    </group>
                </group>
            </sheet>
        </view>

        <!-- ============================================================
             sys.rule — tree + form
        ============================================================ -->
        <view id="view_sys.rule_tree" model="sys.rule" type="tree">
            <field name="name" string="Name"/>
            <field name="model" string="Model"/>
            <field name="active" string="Active"/>
        </view>

        <view id="view_sys.rule_form" model="sys.rule" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="e.g. Sales: own records only"/>
                    </h1>
                </div>
                <group>
                    <group string="Scope">
                        <field name="model" string="Model (technical name)"/>
                        <field name="active" string="Active"/>
                    </group>
                    <group string="Applicable Operations">
                        <field name="perm_read" string="Read"/>
                        <field name="perm_write" string="Write"/>
                        <field name="perm_create" string="Create"/>
                        <field name="perm_unlink" string="Delete"/>
                    </group>
                </group>
                <group>
                    <group string="Domain Filter" colspan="2">
                        <field name="domain_force" string="Domain (JSON, e.g. [[&quot;user_id&quot;,&quot;=&quot;,&quot;uid&quot;]])"/>
                    </group>
                </group>
            </sheet>
        </view>

        <!-- ============================================================
             Actions — point to both tree and form so "New" works
        ============================================================ -->
        <record id="access_action_core.group" model="sys.action.window">
            <field name="name">access_action_core.group</field>
            <field name="core_model">core.group</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="access_action_core.group_user_types" model="sys.action.window">
            <field name="name">access_action_core.group_user_types</field>
            <field name="core_model">core.group</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["category_id","=","base.module_category_user_types"]]</field>
        </record>

        <record id="access_action_sys.access" model="sys.action.window">
            <field name="name">access_action_sys.access</field>
            <field name="core_model">sys.access</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="access_action_sys.rule" model="sys.action.window">
            <field name="name">access_action_sys.rule</field>
            <field name="core_model">sys.rule</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ============================================================
             Menus — Groups under Users; technical ACL under Configuration
        ============================================================ -->
        <menuitem id="menu_user_groups" name="Groups" parent="base.menu_user_section" sequence="30"
                  action="base.access_action_core.group" groups="base.group_system" web_icon="users"/>
        <menuitem id="menu_user_types" name="User Types" parent="base.menu_user_section" sequence="40"
                  action="base.access_action_core.group_user_types" groups="base.group_system" web_icon="user"/>

        <menuitem id="menu_security_access"  name="Access Rights" parent="base.menu_company_configuration" sequence="16" action="base.access_action_sys.access"  groups="base.group_system" web_icon="settings"/>
        <menuitem id="menu_security_rules"   name="Record Rules"  parent="base.menu_company_configuration" sequence="17" action="base.access_action_sys.rule"           groups="base.group_system" web_icon="settings"/>
    </data>
</sumeru>

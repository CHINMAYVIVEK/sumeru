<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_core.country_tree" model="core.country" type="tree">
            <field name="name" string="Country"/>
            <field name="code" string="Code"/>
            <field name="phone_code" string="Phone Code"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_core.country_form" model="core.country" type="form">
            <sheet>
                <group>
                    <field name="name" string="Country"/>
                    <field name="code" string="Code"/>
                    <field name="phone_code" string="Phone Code"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>

        <view id="view_core.country.state_tree" model="core.country.state" type="tree">
            <field name="name" string="State"/>
            <field name="code" string="Code"/>
            <field name="country_id" string="Country"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_core.country.state_form" model="core.country.state" type="form">
            <sheet>
                <group>
                    <field name="name" string="State"/>
                    <field name="code" string="Code"/>
                    <field name="country_id" string="Country" widget="selection"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>

        <view id="view_core.city_tree" model="core.city" type="tree">
            <field name="name" string="City"/>
            <field name="state_id" string="State"/>
            <field name="country_id" string="Country"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_core.city_form" model="core.city" type="form">
            <sheet>
                <group>
                    <field name="name" string="City"/>
                    <field name="country_id" string="Country" widget="selection"/>
                    <field name="state_id" string="State" widget="selection"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>

        <record id="action_core.country" model="sys.action.window">
            <field name="name">action_core.country</field>
            <field name="core_model">core.country</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_core.country.state" model="sys.action.window">
            <field name="name">action_core.country.state</field>
            <field name="core_model">core.country.state</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_core.city" model="sys.action.window">
            <field name="name">action_core.city</field>
            <field name="core_model">core.city</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_geo_section" name="Localization" parent="menu_settings_root" sequence="60" web_icon="settings" groups="base.group_system"/>
        <menuitem id="menu_core_country" name="Countries" parent="menu_geo_section" sequence="10" action="base.action_core.country" web_icon="settings" groups="base.group_system"/>
        <menuitem id="menu_core_country_state" name="States" parent="menu_geo_section" sequence="20" action="base.action_core.country.state" web_icon="settings" groups="base.group_system"/>
        <menuitem id="menu_core_city" name="Cities" parent="menu_geo_section" sequence="30" action="base.action_core.city" web_icon="settings" groups="base.group_system"/>
    </data>
</sumeru>

<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_sys.audit_tree" model="sys.audit" type="tree">
            <field name="create_date" string="When"/>
            <field name="user_id" string="User"/>
            <field name="action" string="Action"/>
            <field name="model" string="Model"/>
            <field name="res_id" string="Record"/>
            <field name="detail" string="Detail"/>
        </view>
        <view id="view_sys.audit_form" model="sys.audit" type="form">
            <sheet>
                <group>
                    <group string="Event">
                        <field name="create_date" string="When"/>
                        <field name="user_id" string="User"/>
                        <field name="action" string="Action"/>
                        <field name="model" string="Model"/>
                        <field name="res_id" string="Record"/>
                    </group>
                    <group string="Payload">
                        <field name="before_json" string="Before"/>
                        <field name="after_json" string="After"/>
                        <field name="detail" string="Detail"/>
                    </group>
                </group>
            </sheet>
        </view>

        <view id="view_sys.attachment_tree" model="sys.attachment" type="tree">
            <field name="name" string="Name"/>
            <field name="model" string="Model"/>
            <field name="res_id" string="Record"/>
            <field name="mimetype" string="Type"/>
            <field name="file_size" string="Size"/>
        </view>
        <view id="view_sys.attachment_form" model="sys.attachment" type="form">
            <sheet>
                <group>
                    <field name="name" string="Name"/>
                    <field name="model" string="Model"/>
                    <field name="res_id" string="Record"/>
                    <field name="mimetype" string="MIME Type"/>
                    <field name="file_size" string="Size"/>
                    <field name="store_fname" string="Stored Filename"/>
                    <field name="company_id" string="Company"/>
                </group>
            </sheet>
        </view>

        <view id="view_sys.sequence_tree" model="sys.sequence" type="tree">
            <field name="name" string="Name"/>
            <field name="code" string="Code"/>
            <field name="prefix" string="Prefix"/>
            <field name="number_next" string="Next"/>
            <field name="active" string="Active"/>
        </view>
        <view id="view_sys.sequence_form" model="sys.sequence" type="form">
            <sheet>
                <group>
                    <field name="name" string="Name"/>
                    <field name="code" string="Code"/>
                    <field name="prefix" string="Prefix"/>
                    <field name="suffix" string="Suffix"/>
                    <field name="padding" string="Padding"/>
                    <field name="number_next" string="Next Number"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>

        <view id="view_sys.config_parameter_tree" model="sys.config_parameter" type="tree">
            <field name="key" string="Key"/>
            <field name="value" string="Value"/>
        </view>
        <view id="view_sys.config_parameter_form" model="sys.config_parameter" type="form">
            <sheet>
                <group>
                    <field name="key" string="Key"/>
                    <field name="value" string="Value"/>
                </group>
            </sheet>
        </view>

        <record id="action_sys.audit" model="sys.action.window">
            <field name="name">action_sys.audit</field>
            <field name="core_model">sys.audit</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_sys.attachment" model="sys.action.window">
            <field name="name">action_sys.attachment</field>
            <field name="core_model">sys.attachment</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_sys.sequence" model="sys.action.window">
            <field name="name">action_sys.sequence</field>
            <field name="core_model">sys.sequence</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_sys.config_parameter" model="sys.action.window">
            <field name="name">action_sys.config_parameter</field>
            <field name="core_model">sys.config_parameter</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_audit_section" name="Audit" parent="menu_settings_root" sequence="80" web_icon="log"/>
        <menuitem id="menu_sys_audit" name="Audit Trail" parent="menu_audit_section" sequence="10" action="base.action_sys.audit" web_icon="log"/>
        <menuitem id="menu_sys_attachment" name="Attachments" parent="menu_company_configuration" sequence="40" action="base.action_sys.attachment" web_icon="settings"/>
        <menuitem id="menu_sys_sequence" name="Sequences" parent="menu_company_configuration" sequence="50" action="base.action_sys.sequence" web_icon="settings"/>
        <menuitem id="menu_sys_config" name="System Parameters" parent="menu_company_configuration" sequence="60" action="base.action_sys.config_parameter" web_icon="settings"/>
    </data>
</sumeru>

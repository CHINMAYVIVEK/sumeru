<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_core.user.apikey_tree" model="core.user.apikey" type="tree">
            <field name="name" string="Name"/>
            <field name="user_id" string="User"/>
            <field name="key_prefix" string="Prefix"/>
            <field name="active" string="Active"/>
            <field name="create_date" string="Created"/>
        </view>

        <view id="view_core.user.apikey_form" model="core.user.apikey" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="e.g. CI integration"/>
                    </h1>
                </div>
                <group>
                    <group string="Key">
                        <field name="user_id" string="User"/>
                        <field name="key_prefix" string="Prefix" readonly="1"/>
                        <field name="active" string="Active"/>
                        <field name="create_date" string="Created" readonly="1"/>
                    </group>
                </group>
            </sheet>
        </view>

        <view id="view_core.user.log_tree" model="core.user.log" type="tree">
            <field name="create_date" string="When"/>
            <field name="user_id" string="User"/>
            <field name="result" string="Result"/>
            <field name="ip" string="IP"/>
        </view>

        <record id="action_core.user.apikey" model="sys.action.window">
            <field name="name">action_core.user.apikey</field>
            <field name="core_model">core.user.apikey</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_core.user.log" model="sys.action.window">
            <field name="name">action_core.user.log</field>
            <field name="core_model">core.user.log</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem id="menu_user_apikeys" name="API Keys" parent="menu_user_section" sequence="30" action="base.action_core.user.apikey" web_icon="settings"/>
        <menuitem id="menu_user_login_log" name="Login History" parent="menu_user_section" sequence="40" action="base.action_core.user.log" web_icon="log"/>
    </data>
</sumeru>
